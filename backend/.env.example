DATABASE_URL=postgresql://...
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_key
# Buyer-paid processing fee. Set this to your confirmed Paystack commercial rate;
# values are basis points (150 = 1.5%) and kobo. Leave the cap at 0 if none applies.
PAYSTACK_PROCESSING_FEE_BPS=150
PAYSTACK_PROCESSING_FEE_FIXED_KOBO=0
PAYSTACK_PROCESSING_FEE_CAP_KOBO=0
# High/critical open alerts block an admin payout release.
FRAUD_HIGH_VALUE_KOBO=5000000
FRAUD_ORDERS_PER_24H_LIMIT=5
FRAUD_NEW_ACCOUNT_HOURS=24
# Optional: use a deployed BRIDGE URL to receive the Paystack callback.
PAYSTACK_CALLBACK_URL=http://localhost:5173/orders
PAYSTACK_SUBSCRIPTION_CALLBACK_URL=http://localhost:5173/dashboard/plans
# Create matching recurring monthly NGN plans in your Paystack dashboard, then paste their codes here.
PAYSTACK_STANDARD_PLAN_CODE=PLN_replace_with_standard_monthly_plan
PAYSTACK_PREMIUM_PLAN_CODE=PLN_replace_with_premium_monthly_plan
# Prices in kobo: defaults are ₦4,500/month Standard and ₦8,000/month Premium.
STANDARD_PLAN_AMOUNT_KOBO=450000
PREMIUM_PLAN_AMOUNT_KOBO=800000
# Private S3-compatible bucket for KYC/KYB evidence. Do not make this bucket public.
AWS_REGION=eu-west-1
S3_PRIVATE_BUCKET=bridge-private-documents
